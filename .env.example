# Copy to .env and fill in ONLY what you need. Never commit .env (it is gitignored).
# `python app.py` reads .env at start-up; values already set in the shell win.
# The framework and its test suite are fully functional offline without these values.

# --- Autonomous scan: models that write attacks and judge replies ---
# provider:model, comma separated. Providers: ollama, groq, openrouter, openai, custom.
AGENT_REDTEAM_ATTACKER_MODELS=groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b
AGENT_REDTEAM_JUDGE_MODELS=groq:openai/gpt-oss-20b,groq:qwen/qwen3.8-27b
# Keys for hosted providers (only the ones you use)
GROQ_API_KEY=
# Fully local alternative (Ollama, no key):
# AGENT_REDTEAM_ATTACKER_MODELS=ollama:qwen2.5:3b,ollama:llama3.2:3b
# AGENT_REDTEAM_JUDGE_MODELS=ollama:llama3.2:3b,ollama:qwen2.5:3b

# --- Attacker side (baseline tools): LLM judge, LLM case generator, LLM planner ---
# Must be an OpenAI-compatible chat-completions endpoint that YOU are authorized to use.
AGENT_REDTEAM_LLM_BASE_URL=
AGENT_REDTEAM_LLM_MODEL=
AGENT_REDTEAM_LLM_API_KEY=

# --- Target side: the llm:weak / llm:strong agents under test ---
# Unset = local Ollama (http://127.0.0.1:11434/v1, qwen2.5:3b), then the values above.
# A non-loopback URL also needs --allow-external --allowed-hosts <host>.
AGENT_REDTEAM_TARGET_BASE_URL=
AGENT_REDTEAM_TARGET_MODEL=
AGENT_REDTEAM_TARGET_API_KEY=

# --- Hosted demo ---
# 1 = public demo: URL scans only to public internet addresses, capped scans.
AGENT_REDTEAM_PUBLIC_MODE=
