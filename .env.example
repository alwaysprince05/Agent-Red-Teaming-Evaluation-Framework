# Copy to .env and fill in ONLY what you need. Never commit .env (it is gitignored).
# The framework and its test suite are fully functional offline without these values.
#
# --- Attacker side: LLM judge, LLM case generator, LLM planner (adaptive) ---
# Must be an OpenAI-compatible chat-completions endpoint that YOU are authorized to use.
AGENT_REDTEAM_LLM_BASE_URL=
AGENT_REDTEAM_LLM_MODEL=
AGENT_REDTEAM_LLM_API_KEY=

# --- Target side: the llm:weak / llm:strong agents under test ---
# Unset = local Ollama (http://127.0.0.1:11434/v1, qwen2.5:3b), then the values above.
# A non-loopback URL also needs --allow-external --allowed-hosts <host>.
AGENT_REDTEAM_TARGET_BASE_URL=
AGENT_REDTEAM_TARGET_MODEL=
AGENT_REDTEAM_TARGET_API_KEY=
